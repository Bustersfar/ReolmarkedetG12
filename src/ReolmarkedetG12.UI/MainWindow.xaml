<Window x:Class="ReolmarkedetG12.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReolmarkedetG12.UI"
        xmlns:views="clr-namespace:ReolmarkedetG12.UI.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <TabControl>
        <TabItem Header="Reoler">
            <views:ReolerView DataContext="{Binding ReolerViewModel}" />
        </TabItem>
        <TabItem Header="Kunder">
            <views:KunderView DataContext="{Binding KunderViewModel}" />
        </TabItem>
    </TabControl>
</Window>

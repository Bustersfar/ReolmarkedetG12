<UserControl x:Class="ReolmarkedetG12.UI.Views.RackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ReolmarkedetG12.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NullToInverseVisibilityConverter x:Key="NullToInverseVisibilityConverter"/>

        <Style x:Key="RackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Green"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="45"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rack.Status}" Value="Rented">
                    <Setter Property="Background" Value="Red"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Rack.Status}" Value="Terminated">
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="DeepSkyBlue"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RackItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Button Content="{Binding Rack.Number}"
                                Style="{StaticResource RackButtonStyle}"
                                ToolTip="{Binding TerminationDate, StringFormat='Opsagt til {0:dd-MM-yyyy}'}"
                                Command="{Binding DataContext.SelectRackCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClusterRackButtonStyle" TargetType="Button" BasedOn="{StaticResource RackButtonStyle}">
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style x:Key="ClusterItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Button Content="{Binding Rack.Number}"
                                Style="{StaticResource ClusterRackButtonStyle}"
                                ToolTip="{Binding TerminationDate, StringFormat='Opsagt til {0:dd-MM-yyyy}'}"
                                Command="{Binding DataContext.SelectRackCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LeftColumnRackButtonStyle" TargetType="Button" BasedOn="{StaticResource RackButtonStyle}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="60"/>
        </Style>

        <Style x:Key="LeftColumnItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Button Content="{Binding Rack.Number}"
                                Style="{StaticResource LeftColumnRackButtonStyle}"
                                ToolTip="{Binding TerminationDate, StringFormat='Opsagt til {0:dd-MM-yyyy}'}"
                                Command="{Binding DataContext.SelectRackCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Venstre søjle: reol 13 ned til 1 -->
            <ItemsControl Grid.Column="0"
                          ItemsSource="{Binding LeftColumnRacks}"
                          Style="{StaticResource LeftColumnItemsControlStyle}"/>

            <!-- Midten: klynger, samme rækkefølge som plantegningen -->
            <StackPanel Grid.Column="1" Margin="60,0" HorizontalAlignment="Left">

                <ItemsControl ItemsSource="{Binding Cluster_14_18}" Style="{StaticResource ClusterItemsControlStyle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Cluster_19_24}" Style="{StaticResource ClusterItemsControlStyle}" Margin="0,60,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Cluster_25_38}" Style="{StaticResource ClusterItemsControlStyle}" Margin="0,60,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Cluster_39_52}" Style="{StaticResource ClusterItemsControlStyle}" Margin="0,60,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Cluster_53_66}" Style="{StaticResource ClusterItemsControlStyle}" Margin="0,60,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Cluster_67_76}" Style="{StaticResource ClusterItemsControlStyle}" Margin="0,60,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,60,0,0">
                    <ItemsControl ItemsSource="{Binding Cluster_77_78}" Style="{StaticResource ClusterItemsControlStyle}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Cluster_79_80}" Style="{StaticResource ClusterItemsControlStyle}" Margin="60,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>

            <!-- Højre: lejer-panel -->
            <StackPanel Grid.Column="2" Margin="15,0,0,0">
                <TextBlock Text="Vælg lejer:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBox Padding="5" ToolTip="Søg på email eller tlf" Margin="0,0,0,10"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>

                <Border BorderBrush="Black" BorderThickness="1" Padding="10" Margin="0,0,0,20" MinHeight="80">
                    <StackPanel>
                        <!-- Søgeresultater: vises kun hvis der endnu ikke er valgt en lejer -->
                        <ItemsControl ItemsSource="{Binding SearchResults}"
                                      Visibility="{Binding FoundRenter, Converter={StaticResource NullToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.SelectRenterCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock>
                                            <Run Text="{Binding FirstName}"/>
                                            <Run Text="{Binding LastName}"/>
                                            <LineBreak/>
                                            <Run Text="{Binding Email}"/>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Valgt lejer -->
                        <StackPanel Visibility="{Binding FoundRenter, Converter={StaticResource NullToInverseVisibilityConverter}}">
                            <TextBlock Text="{Binding FoundRenter.FirstName}"/>
                            <TextBlock Text="{Binding FoundRenter.LastName}"/>
                            <TextBlock Text="{Binding FoundRenter.Email}"/>
                            <TextBlock Text="{Binding FoundRenter.Phone}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Valgte reoler:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border BorderBrush="Black" BorderThickness="1" Padding="10" MinHeight="80" Margin="0,0,0,20">
                    <ItemsControl ItemsSource="{Binding SelectedRacks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Rack.Number, StringFormat='Reol {0}'}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="Kundens reoler:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border BorderBrush="Black" BorderThickness="1" Padding="10" MinHeight="80" Margin="0,0,0,20">
                    <ItemsControl ItemsSource="{Binding RenterRacks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock FontWeight="Bold">
                        <Run Text="{Binding RackItem.Rack.Number, StringFormat='Reol {0}'}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11">
                        <Run Text="Udlejet fra "/>
                        <Run Text="{Binding Rental.StartDate, StringFormat='{}{0:dd-MM-yyyy}'}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="DarkGoldenrod"
                               Visibility="{Binding Rental.EndDate, Converter={StaticResource NullToInverseVisibilityConverter}}">
                        <Run Text="Opsagt til "/>
                        <Run Text="{Binding Rental.EndDate, StringFormat='{}{0:dd-MM-yyyy}'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Button Content="Opret aftale" Padding="10" Margin="0,0,0,10" Command="{Binding CreateRentalCommand}"/>
                <Button Content="Opsig aftale" Padding="10" Command="{Binding TerminateRentalCommand}"/>
                <Button Content="Fortryd opsigelse" Padding="10" Command="{Binding CancelTerminationCommand}"/>
            </StackPanel>
        </Grid>
    </Viewbox>

</UserControl>
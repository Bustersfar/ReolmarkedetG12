<UserControl x:Class="ReolmarkedetG12.UI.Views.RackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ReolmarkedetG12.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <local:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>

        <Style x:Key="RackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Green"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="45"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rack.Status}" Value="Rented">
                    <Setter Property="Background" Value="Red"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Rack.Status}" Value="Terminated">
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="DeepSkyBlue"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClusterRackButtonStyle" TargetType="Button" BasedOn="{StaticResource RackButtonStyle}">
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style x:Key="ClusterItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Button Content="{Binding Rack.Number}"
                                Style="{StaticResource ClusterRackButtonStyle}"
                                ToolTip="{Binding TerminationDate, StringFormat='Opsagt til {0:dd-MM-yyyy}'}"
                                Command="{Binding DataContext.SelectRackCommand,
                                          RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LeftColumnRackButtonStyle" TargetType="Button" BasedOn="{StaticResource RackButtonStyle}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="60"/>
        </Style>

        <Style x:Key="LeftColumnItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Button Content="{Binding Rack.Number}"
                                Style="{StaticResource LeftColumnRackButtonStyle}"
                                ToolTip="{Binding TerminationDate, StringFormat='Opsagt til {0:dd-MM-yyyy}'}"
                                Command="{Binding DataContext.SelectRackCommand,
                                          RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Kort"-stil til lejer-panelet -->
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#F1EFE8"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="PanelLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="PlaceholderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#A9A79E"/>
        </Style>

        <Style x:Key="RackPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#E6F1FB"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="NeutralActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Reol-området med en fast reference-størrelse på den indre Grid -->
        <Viewbox Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid Width="700" Height="900" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Venstre søjle -->
                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding LeftColumnRacks}"
                              Style="{StaticResource LeftColumnItemsControlStyle}"/>

                <!-- Midten: klynger -->
                <StackPanel Grid.Column="1" Margin="40,0,0,0" HorizontalAlignment="Left">

                    <ItemsControl ItemsSource="{Binding Cluster_14_18}" Style="{StaticResource ClusterItemsControlStyle}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Cluster_19_24}" Style="{StaticResource ClusterItemsControlStyle}" Margin="0,15,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Cluster_25_38}" Style="{StaticResource ClusterItemsControlStyle}" Margin="0,15,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Cluster_39_52}" Style="{StaticResource ClusterItemsControlStyle}" Margin="0,15,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Cluster_53_66}" Style="{StaticResource ClusterItemsControlStyle}" Margin="0,15,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Cluster_67_76}" Style="{StaticResource ClusterItemsControlStyle}" Margin="0,15,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <ItemsControl ItemsSource="{Binding Cluster_77_78}" Style="{StaticResource ClusterItemsControlStyle}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Cluster_79_80}" Style="{StaticResource ClusterItemsControlStyle}" Margin="30,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Viewbox>

        <!-- Højre side: Lejer-panel -->
        <Grid Grid.Column="1" Margin="15,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Vælg lejer" Style="{StaticResource PanelLabelStyle}"/>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <TextBox Padding="6" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Søg efter navn, email eller tlf..."
                           IsHitTestVisible="False"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#A9A79E"
                           Visibility="{Binding SearchQuery, Converter={StaticResource EmptyToVisibilityConverter}}"/>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Søg efter en lejer for at komme i gang"
                                   Style="{StaticResource PlaceholderTextStyle}"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource EmptyToVisibilityConverter}}"/>

                        <ItemsControl ItemsSource="{Binding SearchResults}"
                                      Visibility="{Binding FoundRenter, Converter={StaticResource EmptyToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Left"
                                            Style="{StaticResource NeutralActionButtonStyle}"
                                            Command="{Binding DataContext.SelectRenterCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock>
                                            <Run Text="{Binding FirstName}"/>
                                            <Run Text="{Binding LastName}"/>
                                            <LineBreak/>
                                            <Run Text="{Binding Email}" Foreground="Gray" FontSize="11"/>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding FoundRenter, Converter={StaticResource EmptyToVisibilityConverter}, ConverterParameter=Invert}">
                            <TextBlock FontWeight="Bold">
                                <Run Text="{Binding FoundRenter.FirstName}"/>
                                <Run Text="{Binding FoundRenter.LastName}"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="Gray" Text="{Binding FoundRenter.Email}"/>
                            <TextBlock FontSize="11" Foreground="Gray" Text="{Binding FoundRenter.Phone}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="3" Text="Valgte reoler" Style="{StaticResource PanelLabelStyle}"/>

            <Border Grid.Row="4" Style="{StaticResource PanelCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Ingen reoler valgt"
                                   Style="{StaticResource PlaceholderTextStyle}"
                                   Visibility="{Binding SelectedRacks.Count, Converter={StaticResource EmptyToVisibilityConverter}}"/>

                        <ItemsControl ItemsSource="{Binding SelectedRacks}"
                                      Visibility="{Binding SelectedRacks.Count, Converter={StaticResource EmptyToVisibilityConverter}, ConverterParameter=Invert}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RackPillStyle}">
                                        <TextBlock FontSize="12" Foreground="#0C447C"
                                                   Text="{Binding Rack.Number, StringFormat='Reol {0}'}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="5" Text="Kundens reoler" Style="{StaticResource PanelLabelStyle}"/>

            <Border Grid.Row="6" Style="{StaticResource PanelCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Ingen reoler endnu"
                                   Style="{StaticResource PlaceholderTextStyle}"
                                   Visibility="{Binding RenterRacks.Count, Converter={StaticResource EmptyToVisibilityConverter}}"/>

                        <ItemsControl ItemsSource="{Binding RenterRacks}"
                                      Visibility="{Binding RenterRacks.Count, Converter={StaticResource EmptyToVisibilityConverter}, ConverterParameter=Invert}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock FontWeight="Bold">
                                            <Run Text="{Binding RackItem.Rack.Number, StringFormat='Reol {0}'}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="Gray">
                                            <Run Text="Udlejet fra "/>
                                            <Run Text="{Binding Rental.StartDate, StringFormat='{}{0:dd-MM-yyyy}'}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Rental.MonthlyRent, StringFormat='{}{0:0} kr./md.'}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#854F0B"
                                                   Visibility="{Binding Rental.EndDate, Converter={StaticResource EmptyToVisibilityConverter}, ConverterParameter=Invert}">
                                            <Run Text="Opsagt til "/>
                                            <Run Text="{Binding Rental.EndDate, StringFormat='{}{0:dd-MM-yyyy}'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="7">
                <Button Content="Opret aftale" Style="{StaticResource NeutralActionButtonStyle}" Margin="0,0,0,6" Command="{Binding CreateRentalCommand}"/>
                <Button Content="Opsig aftale" Style="{StaticResource NeutralActionButtonStyle}" Margin="0,0,0,6" Command="{Binding TerminateRentalCommand}"/>
                <Button Content="Fortryd opsigelse" Style="{StaticResource NeutralActionButtonStyle}" Command="{Binding CancelTerminationCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
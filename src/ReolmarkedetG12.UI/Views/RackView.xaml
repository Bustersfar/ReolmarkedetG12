<UserControl x:Class="ReolmarkedetG12.UI.Views.RackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:ReolmarkedetG12.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibility"/>

        <!-- Samme opbygning som "SuccessButton" i App.xaml, blot med rød farve til destruktive handlinger -->
        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource DangerRed}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource DangerRedHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackground}" Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <!-- Venstre side: Reoloversigt -->
        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button Content="Opdater" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}"
                            DockPanel.Dock="Right" Width="90" Height="30" FontSize="12"/>
                    <TextBlock Text="Oversigt over reoler" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Klik på en række markerer/afmarkerer reolen (flere reoler kan vælges på én gang) -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Racks}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          RowHeight="34" SelectionMode="Single" Background="Transparent" BorderThickness="0"
                          SelectionChanged="RacksGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reolnr." Binding="{Binding Rack.Number}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Rack.Status}" Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <!-- Egen markerings-farve, styret af RackDisplayItem.IsSelected (sat af RackViewModel) -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Højre side: Håndtering og Historik -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Håndtering af udlejning -->
            <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Udlejning af reol" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Valgte reoler:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="Ingen reol valgt endnu — klik på en reol i listen til venstre"
                               Visibility="{Binding SelectedRacks.Count, Converter={StaticResource EmptyToVisibility}}"
                               FontStyle="Italic" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding SelectedRacks}" Margin="0,0,0,10"
                                  Visibility="{Binding SelectedRacks.Count, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding Rack.Number, StringFormat='Reol #{0}'}" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Søg lejer:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Søgeresultater: klik på en lejer for at vælge vedkommende -->
                    <ListBox ItemsSource="{Binding SearchResults}" MaxHeight="110" Margin="0,0,0,10"
                             Visibility="{Binding SearchResults.Count, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}"
                             SelectionChanged="SearchResultsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding FirstName}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding LastName}"/>
                                    <Run Text=" — "/>
                                    <Run Text="{Binding Phone}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Valgt lejer:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="Ingen lejer valgt"
                               Visibility="{Binding FoundRenter, Converter={StaticResource EmptyToVisibility}}"
                               FontStyle="Italic" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               Visibility="{Binding FoundRenter, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                        <Run Text="{Binding FoundRenter.FirstName}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding FoundRenter.LastName}"/>
                    </TextBlock>

                    <!-- Lejerens aktive reoler, hvis en lejer er valgt -->
                    <ItemsControl ItemsSource="{Binding RenterRacks}" Margin="0,0,0,14"
                                  Visibility="{Binding RenterRacks.Count, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2">
                                    <Run Text="{Binding RackItem.Rack.Number, StringFormat='Reol #{0}'}"/>
                                    <Run Text=" – "/>
                                    <Run Text="{Binding Rental.MonthlyRent, StringFormat='{}{0:0} kr./md.'}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Opret udlejning" Command="{Binding CreateRentalCommand}"
                            Style="{StaticResource SuccessButton}" Margin="0,0,0,8"/>
                    <Button Content="Opsig lejemål" Command="{Binding TerminateRentalCommand}"
                            Style="{StaticResource DangerActionButton}" Margin="0,0,0,8"/>
                    <Button Content="Annuller opsigelse" Command="{Binding CancelTerminationCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Border>

            <!-- Punkt 14: Lejemålshistorik -->
            <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Lejemålshistorik" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Tidligere lejemål for valgt reol" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RackHistory}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              RowHeight="30" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lejer" Binding="{Binding RenterName}" Width="*"/>
                            <DataGridTextColumn Header="Periode" Binding="{Binding PeriodText}" Width="150"/>
                            <DataGridTextColumn Header="Pris/md." Binding="{Binding MonthlyRent, StringFormat='0 kr.'}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
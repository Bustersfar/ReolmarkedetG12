<UserControl x:Class="ReolmarkedetG12.UI.Views.RackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:ReolmarkedetG12.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibility"/>

        <!-- Samme opbygning som "SuccessButton" i App.xaml, blot med rød farve til destruktive handlinger -->
        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource DangerRed}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource DangerRedHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================== -->
        <!-- Plantegning: knap-styles for de enkelte reoler  -->
        <!-- Farverne følger reolens status (Rack.Status):   -->
        <!-- grøn = ledig, rød = udlejet, orange = opsagt.    -->
        <!-- Blå kant/baggrund = markeret af brugeren.        -->
        <!-- ============================================== -->
        <Style x:Key="RackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SuccessGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tileBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderThickness="2"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Rack.Status}" Value="Rented">
                                <Setter Property="Background" Value="{StaticResource DangerRed}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Rack.Status}" Value="Terminated">
                                <Setter Property="Background" Value="#F59E0B"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
                                <Setter TargetName="tileBorder" Property="BorderBrush" Value="#1E3A8A"/>
                                <Setter TargetName="tileBorder" Property="BorderThickness" Value="2.5"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Klynge-reoler (14-80) er lidt lavere end basisknappen -->
        <Style x:Key="ClusterRackButtonStyle" TargetType="Button" BasedOn="{StaticResource RackButtonStyle}">
            <Setter Property="Height" Value="30"/>
        </Style>

        <!-- Venstre søjle (1-13) er smallere og højere, som i butikkens plantegning -->
        <Style x:Key="LeftColumnRackButtonStyle" TargetType="Button" BasedOn="{StaticResource RackButtonStyle}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="60"/>
        </Style>

        <Style x:Key="RackItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Button Content="{Binding Rack.Number}"
                                Style="{StaticResource ClusterRackButtonStyle}"
                                ToolTip="{Binding TerminationDate, StringFormat='Opsagt til {0:dd-MM-yyyy}'}"
                                Command="{Binding DataContext.SelectRackCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LeftColumnItemsControlStyle" TargetType="ItemsControl" BasedOn="{StaticResource RackItemsControlStyle}">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Button Content="{Binding Rack.Number}"
                                Style="{StaticResource LeftColumnRackButtonStyle}"
                                ToolTip="{Binding TerminationDate, StringFormat='Opsagt til {0:dd-MM-yyyy}'}"
                                Command="{Binding DataContext.SelectRackCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackground}" Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <!-- Venstre side: Plantegning over butikken -->
        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button Content="Opdater" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}"
                            DockPanel.Dock="Right" Width="90" Height="30" FontSize="12"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Oversigt over reoler" Style="{StaticResource SectionHeader}" Margin="0,0,20,0" VerticalAlignment="Center"/>

                        <!-- Signaturforklaring -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="12" Height="12" Background="{StaticResource SuccessGreen}" CornerRadius="3" Margin="0,0,4,0"/>
                            <TextBlock Text="Ledig" FontSize="12" Margin="0,0,12,0" Foreground="{StaticResource TextSecondary}"/>

                            <Border Width="12" Height="12" Background="{StaticResource DangerRed}" CornerRadius="3" Margin="0,0,4,0"/>
                            <TextBlock Text="Udlejet" FontSize="12" Margin="0,0,12,0" Foreground="{StaticResource TextSecondary}"/>

                            <Border Width="12" Height="12" Background="#F59E0B" CornerRadius="3" Margin="0,0,4,0"/>
                            <TextBlock Text="Opsagt" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Reol-plantegning: venstre søjle (1-13) + klynger (14-80), som de              -->
                <!-- fysisk står i butikslokalet. Viewbox skalerer hele plantegningen, så           -->
                <!-- den altid passer i det tilgængelige område.                                    -->
                <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Width="700" Height="900" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Venstre søjle (1-13) -->
                        <ItemsControl Grid.Column="0"
                                      ItemsSource="{Binding LeftColumnRacks}"
                                      Style="{StaticResource LeftColumnItemsControlStyle}"/>

                        <!-- Midten: klynger (14-80) -->
                        <StackPanel Grid.Column="1" Margin="40,0,0,0" HorizontalAlignment="Left">

                            <ItemsControl ItemsSource="{Binding Cluster_14_18}" Style="{StaticResource RackItemsControlStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Cluster_19_24}" Style="{StaticResource RackItemsControlStyle}" Margin="0,15,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Cluster_25_38}" Style="{StaticResource RackItemsControlStyle}" Margin="0,15,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Cluster_39_52}" Style="{StaticResource RackItemsControlStyle}" Margin="0,15,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Cluster_53_66}" Style="{StaticResource RackItemsControlStyle}" Margin="0,15,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Cluster_67_76}" Style="{StaticResource RackItemsControlStyle}" Margin="0,15,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <ItemsControl ItemsSource="{Binding Cluster_77_78}" Style="{StaticResource RackItemsControlStyle}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Cluster_79_80}" Style="{StaticResource RackItemsControlStyle}" Margin="30,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <!-- Højre side: Håndtering og Historik -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Håndtering af udlejning -->
            <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Udlejning af reol" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Valgte reoler:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="Ingen reol valgt endnu — klik på en reol i plantegningen til venstre"
                               Visibility="{Binding SelectedRacks.Count, Converter={StaticResource EmptyToVisibility}}"
                               FontStyle="Italic" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding SelectedRacks}" Margin="0,0,0,10"
                                  Visibility="{Binding SelectedRacks.Count, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding Rack.Number, StringFormat='Reol #{0}'}" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Søg lejer:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Søgeresultater: klik på en lejer for at vælge vedkommende -->
                    <ListBox ItemsSource="{Binding SearchResults}" MaxHeight="110" Margin="0,0,0,10"
                             Visibility="{Binding SearchResults.Count, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}"
                             SelectionChanged="SearchResultsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding FirstName}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding LastName}"/>
                                    <Run Text=" — "/>
                                    <Run Text="{Binding Phone}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Valgt lejer:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="Ingen lejer valgt"
                               Visibility="{Binding FoundRenter, Converter={StaticResource EmptyToVisibility}}"
                               FontStyle="Italic" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               Visibility="{Binding FoundRenter, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                        <Run Text="{Binding FoundRenter.FirstName}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding FoundRenter.LastName}"/>
                    </TextBlock>

                    <!-- Lejerens aktive reoler, hvis en lejer er valgt -->
                    <ItemsControl ItemsSource="{Binding RenterRacks}" Margin="0,0,0,14"
                                  Visibility="{Binding RenterRacks.Count, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2">
                                    <Run Text="{Binding RackItem.Rack.Number, StringFormat='Reol #{0}'}"/>
                                    <Run Text=" – "/>
                                    <Run Text="{Binding Rental.MonthlyRent, StringFormat='{}{0:0} kr./md.'}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Opret udlejning" Command="{Binding CreateRentalCommand}"
                            Style="{StaticResource SuccessButton}" Margin="0,0,0,8"/>
                    <Button Content="Opsig lejemål" Command="{Binding TerminateRentalCommand}"
                            Style="{StaticResource DangerActionButton}" Margin="0,0,0,8"/>
                    <Button Content="Annuller opsigelse" Command="{Binding CancelTerminationCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Border>

            <!-- Lejemålshistorik -->
            <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Lejemålshistorik" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Tidligere lejemål for valgt reol" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RackHistory}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              RowHeight="30" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lejer" Binding="{Binding RenterName}" Width="*"/>
                            <DataGridTextColumn Header="Periode" Binding="{Binding PeriodText}" Width="150"/>
                            <DataGridTextColumn Header="Pris/md." Binding="{Binding MonthlyRent, StringFormat='0 kr.'}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
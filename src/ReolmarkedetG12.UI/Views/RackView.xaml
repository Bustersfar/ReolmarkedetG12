<UserControl x:Class="ReolmarkedetG12.UI.Views.RackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1100">
    <Grid Background="#F4F6F9" Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <!-- Venstre side: Reoloversigt -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,16,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                    <TextBlock Text="Oversigt over reoler" FontWeight="Bold" FontSize="16" Foreground="#2D3748" VerticalAlignment="Center"/>
                    <Button Content="Opdater" Command="{Binding RefreshCommand}" 
                            HorizontalAlignment="Right" Width="80" Height="28" Margin="20,0,0,0"
                            Background="#E2E8F0" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Racks}" SelectedItem="{Binding SelectedRack}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          RowHeight="34" SelectionMode="Single" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reolnr." Binding="{Binding Rack.Number}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Rack.Status}" Width="120"/>
                        <DataGridTextColumn Header="Nuværende lejer" Binding="{Binding CurrentRenter}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Højre side: Håndtering og Historik -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Håndtering af udlejning -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Udlejning af reol" FontWeight="Bold" FontSize="16" Foreground="#2D3748" Margin="0,0,0,12"/>

                    <TextBlock Text="Valgt reol:" FontWeight="SemiBold" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding SelectedRack.Rack.Number, StringFormat='Reol #{0}', FallbackValue='Ingen reol valgt'}" 
                               FontSize="14" Foreground="#4A5568" Margin="0,0,0,10"/>

                    <TextBlock Text="Vælg lejer:" FontWeight="SemiBold" Margin="0,4,0,2"/>
                    <ComboBox ItemsSource="{Binding Renters}" SelectedItem="{Binding SelectedRenter}"
                              Height="32" Margin="0,0,0,10" VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding FirstName}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding LastName}"/>
                                    <Run Text=" (Tlf: "/>
                                    <Run Text="{Binding Phone}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Månedlig leje (kr.):" FontWeight="SemiBold" Margin="0,4,0,2"/>
                    <TextBox Text="{Binding NewMonthlyRent, UpdateSourceTrigger=PropertyChanged, StringFormat='0.00'}" 
                             Height="32" VerticalContentAlignment="Center" Margin="0,0,0,14" Padding="6,0"/>

                    <Button Content="Opret udlejning" Command="{Binding RentOutCommand}" 
                            Height="36" Background="#2B6CB0" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8"/>

                    <Button Content="Afslut aktivt lejemål" Command="{Binding EndRentalCommand}" 
                            Height="34" Background="#E53E3E" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Punkt 14: Lejemålshistorik -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Lejemålshistorik" FontWeight="Bold" FontSize="15" Foreground="#2D3748"/>
                        <TextBlock Text="Tidligere lejemål for valgt reol" FontSize="11" Foreground="#718096"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RackHistory}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              RowHeight="30" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lejer" Binding="{Binding RenterName}" Width="*"/>
                            <DataGridTextColumn Header="Periode" Binding="{Binding PeriodText}" Width="150"/>
                            <DataGridTextColumn Header="Pris/md." Binding="{Binding MonthlyRent, StringFormat='0 kr.'}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
<UserControl x:Class="ReolmarkedetG12.UI.Views.RenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontSize="14">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- VENSTRE SIDE: FORMULAR TIL KUNDEDATA          -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Style="{StaticResource CardPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header -->
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="Kundeoplysninger" 
                                   Style="{StaticResource SectionHeader}" 
                                   DockPanel.Dock="Left" 
                                   Margin="0"/>

                        <Button Content="+ Ny kunde" 
                                Command="{Binding NewCommand}" 
                                Style="{StaticResource SecondaryButton}"
                                Height="30"
                                Padding="10,0"
                                FontSize="12"
                                HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Navnefelter i to kolonner -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fornavn *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Efternavn *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Adresse -->
                    <TextBlock Text="Adresse *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Postnr og By i to kolonner -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Postnr. *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="By *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Telefon -->
                    <TextBlock Text="Telefon" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- E-mail -->
                    <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <Separator Margin="0,10,0,16" Background="#E2E8F0"/>

                    <!-- Handlingsknapper -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Gem kunde -->
                        <Button Grid.Column="0" 
                                Content="Gem kunde" 
                                Command="{Binding SaveCommand}" 
                                Style="{StaticResource SuccessButton}" 
                                Height="42"/>

                        <!-- Slet kunde -->
                        <Button Grid.Column="2" 
                                Content="Slet" 
                                Command="{Binding DeleteCommand}" 
                                Height="42"
                                Width="75"
                                Background="Transparent"
                                BorderBrush="{StaticResource DangerRed}"
                                BorderThickness="1"
                                Foreground="{StaticResource DangerRed}"
                                FontWeight="SemiBold"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================================== -->
        <!-- HØJRE SIDE: KUNDEOVERSIGT OG SØGNING          -->
        <!-- ============================================== -->
        <Border Grid.Column="2" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Topbar med søgning og optælling -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Height="36" 
                             Margin="0"
                             Padding="10,0"
                             VerticalContentAlignment="Center"/>

                    <!-- Placeholder-lignende hjælpetekst hvis søgefelt er tomt -->
                    <TextBlock Grid.Column="0" 
                               Text="Søg på navn, tlf eller e-mail..." 
                               IsHitTestVisible="False" 
                               VerticalAlignment="Center" 
                               Margin="12,0,0,0" 
                               Foreground="#94A3B8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="2" 
                            Content="Vis alle" 
                            Command="{Binding GetAllCommand}" 
                            Style="{StaticResource SecondaryButton}" 
                            Height="36" 
                            Padding="14,0"/>

                    <TextBlock Grid.Column="3" 
                               Text="{Binding Renters.Count, StringFormat='{}{0} kunde(r)'}" 
                               Foreground="{StaticResource TextSecondary}" 
                               VerticalAlignment="Center" 
                               Margin="16,0,0,0"/>
                </Grid>

                <!-- Tabel med kunder -->
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding Renters}" 
                          SelectedItem="{Binding SelectedRenter}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          BorderThickness="1"
                          BorderBrush="{StaticResource CardBorder}"
                          RowHeight="38"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fornavn" Binding="{Binding FirstName}" Width="130"/>
                        <DataGridTextColumn Header="Efternavn" Binding="{Binding LastName}" Width="140"/>
                        <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="110"/>
                        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="190"/>
                        <DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="Postnr" Binding="{Binding PostalCode}" Width="75"/>
                        <DataGridTextColumn Header="By" Binding="{Binding City}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
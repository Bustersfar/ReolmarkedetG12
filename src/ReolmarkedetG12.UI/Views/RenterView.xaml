<UserControl x:Class="ReolmarkedetG12.UI.Views.RenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ReolmarkedetG12.UI.Converters"
             mc:Ignorable="d"
            d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Titel-->
        <TextBlock Text="LEJERE" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" Foreground="#FF0E0606" Background="#FFFFFEFE"/>


        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,8,0" Background="#FFD8D3D3">

                <StackPanel>
                    <TextBlock Text="Fornavn" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Efternavn" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>


                    <TextBlock Text="Email" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>


                    <TextBlock Text="Telefonnummer" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Adresse" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Postnummer" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="By" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>


                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Ryd" Width="100" Margin="0,0,8,0"
                            Command="{Binding NewCommand}" Background="White"/>

                        <Button Content="Gem" Width="100" Margin="0,0,8,0"
                            Command="{Binding SaveCommand}" Background="White"/>

                        <Button Content="Slet" Width="100"
                            Command="{Binding DeleteCommand}" Background="White"/>
                    </WrapPanel>

                    <Separator Margin="0,15,0,15"/>
                    <TextBlock Text="Søg" FontSize="16" FontWeight="Bold"/>
                    <Grid Margin="0,5,0,10">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Søg efter fornavn, efternavn, email eller telefonnummer..."
                        IsHitTestVisible="False"
                        FontSize="12" Foreground="Gray" Margin="5,0,0,0"
                        Visibility="{Binding SearchQuery, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                    </Grid>

                    <WrapPanel>
                        <Button Content="Hent alle" Width="100"
                            Command="{Binding GetAllCommand}" Background="White"/>
                    </WrapPanel>
                    
                </StackPanel>
            </Border>

            <!--Datagrid-->
            <DataGrid Grid.Column="1" ItemsSource="{Binding Renters}" SelectedItem="{Binding SelectedRenter}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="LejerID" Binding="{Binding RenterId}" Width="50"/>
                    <DataGridTextColumn Header="Fornavn" Binding="{Binding FirstName}" Width="*"/>
                    <DataGridTextColumn Header="Efternavn" Binding="{Binding LastName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*"/>
                    <DataGridTextColumn Header="Telefonnummer" Binding="{Binding Phone}" Width="*"/>
                    <DataGridTextColumn Header="By" Binding="{Binding City}" Width="*"/>
                    <DataGridTextColumn Header="Postnummer" Binding="{Binding PostalCode}" Width="*"/>
                    <DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
            
        </Grid>

    </Grid>
    
</UserControl>

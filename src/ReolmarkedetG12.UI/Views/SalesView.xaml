<UserControl x:Class="ReolmarkedetG12.UI.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             FontSize="14">

    <UserControl.Resources>
        <!-- Konverter til at vise/skjule kontantfelter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- VENSTRE SIDE: 1. INDTAST VARE             -->
        <!-- ========================================== -->
        <Border Grid.Column="0" 
                Background="#F9FAFB" 
                BorderBrush="#E5E7EB" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20">
            
            <StackPanel>
                
                <TextBlock Text="1. Find vare" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#1F2937" 
                           Margin="0,0,0,16"/>

                <!-- Indtast Varenummer -->
                <TextBlock Text="Varenummer *" Style="{StaticResource LabelStyle}"/>

                <TextBox Text ="{Binding ItemNumber, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                <TextBlock Text="{Binding ItemStatusMessage}" Foreground="Red" Margin="0,5,0,0"/>

                <Border Margin="0,10,0,10"
                        Padding="10"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="Vareinformation" Style="{StaticResource LabelStyle}"/>
                        
                        <TextBlock>
                            <Run Text="Varenavn: "/>
                            <Run Text="{Binding SelectedItem.Name}"/>
                        </TextBlock>
                        
                        <TextBlock>
                            <Run Text="Varenummer: "/>
                            <Run Text="{Binding SelectedItem.ItemNumber}"/>
                        </TextBlock>
                        
                        <TextBlock Margin="0,5,0,0">
                            <Run Text="Pris: "/>
                            <Run Text="{Binding SelectedItem.Price, StringFormat={}{0:0.00} kr.}"/>
                        </TextBlock>
                        
                        <TextBlock Margin="0,5,0,0">
                             <Run Text="Reol: "/>
                             <Run Text="{Binding SelectedItem.RackId}"/>
                        </TextBlock>
                        
                    </StackPanel>
                </Border>



                <!-- Knap: Tilføj vare -->
                <Button Content="Tilføj vare til kurv"
                        Command="{Binding AddItemCommand}"
                        Height="40" 
                        Background="#2563EB" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Margin="0,10,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- HØJRE SIDE: 2. KURV & 3. AFSLUT SALG       -->
        <!-- ========================================== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 2. Aktuelt køb (DataGrid) -->
            <Border Grid.Row="0" 
                    Background="White" 
                    BorderBrush="#E5E7EB" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="2. Aktuelt salg (kurv)" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#1F2937" 
                                   DockPanel.Dock="Left"/>

                        <TextBlock Text="{Binding CartItems.Count, StringFormat='{}{0} vare(r) i kurv'}" 
                                   Foreground="#6B7280" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Tabel over varer -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding CartItems}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F3F4F6"
                              BorderThickness="1"
                              BorderBrush="#E5E7EB"
                              RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Varenummer" Binding="{Binding ItemNumber}" Width="100"/>
                            <DataGridTextColumn Header="Vare" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="Pris" Binding="{Binding Price, StringFormat='{}{0:0.00} kr.'}" Width="110"/>

                            <!-- Slet / Ret handlinger -->
                            <DataGridTemplateColumn Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Slet" 
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}" 
                                                    Foreground="#DC2626" 
                                                    Padding="8,2" 
                                                    FontSize="12"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Annuller knap -->
                    <Button Grid.Row="2" 
                            Content="Annuller / tøm kurv" 
                            Command="{Binding ClearCartCommand}" 
                            HorizontalAlignment="Left" 
                            Margin="0,10,0,0" 
                            Padding="12,6" 
                            Background="Transparent" 
                            Foreground="#6B7280" 
                            BorderBrush="#D1D5DB" 
                            Cursor="Hand"/>

                </Grid>
            </Border>

            <!-- 3. Afslut salg (Total & betaling) -->
            <Border Grid.Row="1" 
                    Background="#F9FAFB" 
                    BorderBrush="#E5E7EB" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20" 
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Venstre del: Betalingstype og modtaget -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Betalingsform" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding PaymentMethods}" 
                                  SelectedItem="{Binding SelectedPaymentMethod}" 
                                  Height="32" 
                                  Margin="0,4,0,12"/>

                        <!-- Vises kun hvis Betalingsform er Kontant -->
                        <StackPanel Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Modtaget beløb (kr.)" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}, TargetNullValue=''}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Højre del: Totalbeløb, Byttepenge og Gennemfør-knap -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Total:" FontSize="18" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:0.00} kr.'}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="#111827" 
                                       HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Byttepenge (kun ved kontant) -->
                        <DockPanel Margin="0,0,0,16" Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Byttepenge:" FontSize="15" Foreground="#4B5563"/>
                            <TextBlock Text="{Binding Change, StringFormat='{}{0:0.00} kr.'}" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#059669" 
                                       HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Gennemfør salg knap -->
                        <Button Content="Gennemfør salg" 
                                Command="{Binding RegisterSaleCommand}" 
                                Height="46" 
                                Background="#059669" 
                                Foreground="White" 
                                FontSize="16" 
                                FontWeight="Bold" 
                                BorderThickness="0" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    
</UserControl>
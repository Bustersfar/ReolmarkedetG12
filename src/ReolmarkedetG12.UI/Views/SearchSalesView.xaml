<UserControl x:Class="ReolmarkedetG12.UI.Views.SearchSalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:ReolmarkedetG12.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             FontSize="14">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- Hvis ikke låst op: Vis låseskærm -->
        <views:LockScreenView DataContext="{Binding Lock}" 
                              Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <views:LockScreenView.Style>
                <Style TargetType="views:LockScreenView">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:LockScreenView.Style>
        </views:LockScreenView>

        <!-- Hvis låst op: Vis søg & ret interface -->
        <Grid Margin="20">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Lock.IsUnlocked}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Søgefiltre -->
            <Border Grid.Row="0" 
                    Background="#F9FAFB" 
                    BorderBrush="#E5E7EB" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Reolfilter -->
                    <TextBlock Grid.Column="0" Text="Reolnummer:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchRackNumber, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                             Height="32" 
                             VerticalContentAlignment="Center" 
                             Padding="6,0"/>

                    <!-- Datofilter -->
                    <TextBlock Grid.Column="3" Text="Dato:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <DatePicker Grid.Column="4" 
                                SelectedDate="{Binding SearchDate}" 
                                Height="32" 
                                VerticalContentAlignment="Center"/>

                    <!-- Søg og Ryd knapper -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <Button Content="Søg" 
                                Command="{Binding SearchCommand}" 
                                Width="90" 
                                Height="34" 
                                Background="#2563EB" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                Margin="0,0,8,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Ryd filtre" 
                                Command="{Binding ResetSearchCommand}" 
                                Width="90" 
                                Height="34" 
                                Background="Transparent" 
                                BorderBrush="#D1D5DB" 
                                Foreground="#4B5563" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tabel med resultater -->
            <Border Grid.Row="1" 
                    Background="White" 
                    BorderBrush="#E5E7EB" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Fundne salg (klik på Pris eller Beskrivelse for at rette)" 
                                   FontWeight="SemiBold" 
                                   Foreground="#4B5563" 
                                   DockPanel.Dock="Left"/>

                        <TextBlock Text="{Binding SaleResults.Count, StringFormat='{}{0} resultat(er)'}" 
                                   Foreground="#6B7280" 
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding SaleResults}" 
                              SelectedItem="{Binding SelectedSaleItem}"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F3F4F6"
                              BorderThickness="1"
                              BorderBrush="#E5E7EB"
                              RowHeight="36">
                        <DataGrid.Columns>
                            <!-- ID -->
                            <DataGridTextColumn Header="Salg ID" Binding="{Binding SaleId}" IsReadOnly="True" Width="80"/>

                            <!-- Reol -->
                            <DataGridTextColumn Header="Reol" Binding="{Binding RackNumber, StringFormat='Reol {0}'}" IsReadOnly="True" Width="90"/>

                            <!-- Lejer -->
                            <DataGridTextColumn Header="Lejer" Binding="{Binding RenterName}" IsReadOnly="True" Width="180"/>

                            <!-- Dato -->
                            <DataGridTextColumn Header="Dato &amp; Tid" Binding="{Binding Date, StringFormat='{}{0:dd-MM-yyyy HH:mm}'}" IsReadOnly="True" Width="150"/>

                            <!-- Pris (Redigerbar) -->
                            <DataGridTextColumn Header="Pris (kr.)" Binding="{Binding Amount, StringFormat='{}{0:0.00}', UpdateSourceTrigger=LostFocus}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Beskrivelse (Redigerbar) -->
                            <DataGridTextColumn Header="Beskrivelse" Binding="{Binding Description, UpdateSourceTrigger=LostFocus}" Width="*"/>

                            <!-- Slet handling -->
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Slet" 
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" 
                                                Foreground="#DC2626" 
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Bundbar: Gem ændringer -->
            <DockPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="Husk at trykke 'Gem ændringer' når du har rettet i tabellen." 
                           Foreground="#6B7280" 
                           VerticalAlignment="Center" 
                           DockPanel.Dock="Left"/>

                <Button Content="Gem ændringer" 
                        Command="{Binding UpdateCommand}" 
                        Height="40" 
                        Width="150" 
                        Background="#059669" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        HorizontalAlignment="Right">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>